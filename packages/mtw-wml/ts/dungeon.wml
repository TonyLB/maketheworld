<Asset uuid=(Dungeon)>
    <Area key=(dungeonTopology)>
        <Room key=(VORTEX) />
        <Room key=(cave) />
        <Room key=(curvingPassage) />
        <Room key=(chamber) />
        <Exit uuid=(e_vortex_cave)>
            <From>VORTEX</From>
            <To>cave</To>
            <Forward>cave</Forward>
            <Back>out</Back>
        </Exit>
        <Exit uuid=(e_cave_passage)>
            <From>cave</From>
            <To>curvingPassage</To>
            <Forward>passage</Forward>
            <Back>cave</Back>
        </Exit>
        <Exit uuid=(e_passage_chamber)>
            <From>curvingPassage</From>
            <To>chamber</To>
            <Forward>chamber</Forward>
            <Back>passage</Back>
        </Exit>
    </Area>
    <Room key=(VORTEX)>
        <Situation ref={0} uuid=(example1)>
            <Description>
                Natural rock formations rise in a jagged cliff-face. An asymmetric
                opening leads into a dimly lit cave. 
                <br />
                (You could also go literally anywhere else in the world, if any of
                it had been created. But it hasn't)
            </Description>
            <DisplayName>Cave entrance</DisplayName>
        </Situation>
    </Room>
    <Map key=(dungeonMap)>
        <Image key=(dungeonImage) />
        <Room key=(VORTEX)>
            <Position {0, 250} />
        </Room>
        <Room key=(cave)>
            <Position {0, 150} />
        </Room>
        <Room key=(curvingPassage)>
            <Position {-150, 100} />
        </Room>
        <Room key=(chamber)>
            <Position {-150, 0} />
        </Room>
    </Map>
    <Room key=(cave)>
        <Situation ref={0} uuid=(example2)>
            <DisplayName>Shallow cave</DisplayName>
            <Description>Light streams in from the entrance. On one side of the cave is an old firepit and comfortably tamped-down earth floor. At the opposite end, a jumbled pile of jagged rocks against the wall make a far less hospitable space.</Description>
        </Situation>
        <Situation ref={0} uuid=(example3)>
            <DisplayName>Shallow cave</DisplayName>
            <Description>Light streams in from the entrance. On one side of the cave is an old firepit and comfortably tamped-down earth floor. At the opposite end, rocks have been cleared revealing a passage further underground.</Description>
        </Situation>
    </Room>
    <Room key=(curvingPassage)>
        <Situation ref={0} uuid=(example4)>
            <DisplayName>Curving Passage</DisplayName>
            <Description>Walls smoothly cut from the bedrock curve in a long arc, lit every few yards by a small sconce mounted above eye-level.</Description>
        </Situation>
    </Room>
    <Room key=(chamber)>
        <Feature key=(orc)>
        </Feature>
        <Feature key=(pie)>
        </Feature>
        <Situation ref={0} uuid=(example5)>
            <Description>
                A ten-by-ten squared off cut stone room. Across from the passage leading in is a table with a
                <Link to=(pie)>pie</Link>. Standing before the table is an angry 
                <Link to=(orc)>orc</Link>.
            </Description>
        </Situation>
    </Room>
</Asset>
